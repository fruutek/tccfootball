{
  "name": "monday-night-football",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Statistics, results and news for our Monday night football group. Astro + Firestore + Firebase Hosting.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-mnf \"vitest run --config vitest.emulator.config.ts\"",
    "test:all": "npm run test && npm run test:rules",
    "test:e2e": "tsx scripts/e2e.ts",
    "emulators": "firebase emulators:start --only firestore,hosting --project demo-mnf",
    "mnf": "tsx cli/index.ts",
    "setup:firebase": "tsx scripts/setup-firebase.ts",
    "deploy:rules": "firebase deploy --only firestore"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "astro": "^6.4.8",
    "firebase": "^12.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.2",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  }
}
