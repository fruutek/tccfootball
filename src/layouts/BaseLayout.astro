---
import '@fontsource-variable/big-shoulders-display/wght';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow/700.css';
import '../styles/global.css';
import DemoBanner from '../islands/DemoBanner';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Results, player statistics, leaderboards and news from our Monday night football.' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'Home', match: (p: string) => p === '/' },
  { href: '/matches', label: 'Results', match: (p: string) => p.startsWith('/matches') },
  { href: '/players', label: 'Players', match: (p: string) => p.startsWith('/players') },
  { href: '/leaderboards', label: 'Table', match: (p: string) => p.startsWith('/leaderboards') },
  { href: '/news', label: 'News', match: (p: string) => p.startsWith('/news') },
];
const icons: Record<string, string> = {
  '/': 'M3.5 11L12 3.5 20.5 11V20a1 1 0 01-1 1H15v-6H9v6H4.5a1 1 0 01-1-1v-9z',
  '/matches': 'M4.5 4.5h15a1 1 0 011 1v14a1 1 0 01-1 1h-15a1 1 0 01-1-1v-14a1 1 0 011-1zM3.5 9.5h17M8 2.8v3.4M16 2.8v3.4M8 14h3M8 17h6',
  '/players': 'M9 11.4a3.4 3.4 0 100-6.8 3.4 3.4 0 000 6.8zM2.8 20c.4-3.6 3-5.6 6.2-5.6s5.8 2 6.2 5.6M16 4.8a3.2 3.2 0 010 6.2M18.2 14.8c1.8.8 2.8 2.4 3 5.2',
  '/leaderboards': 'M4 20V10M10 20V4M16 20v-7M22 20H2',
  '/news': 'M5 4.5h11a1 1 0 011 1V20H6a2 2 0 01-2-2V5.5a1 1 0 011-1zM17 9h3v9a2 2 0 01-2 2M8 8.5h6M8 12h6M8 15.5h4',
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0d10" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <DemoBanner client:load />
    <header class="topbar">
      <div class="container topbar__in">
        <a class="brand" href="/" aria-label="Monday Night Football — home">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="3" fill="#c6f432" />
            <path d="M16 4v24" stroke="#0b0d10" stroke-width="2.4" />
            <circle cx="16" cy="16" r="6.4" fill="none" stroke="#0b0d10" stroke-width="2.4" />
            <circle cx="16" cy="16" r="1.8" fill="#0b0d10" />
          </svg>
          <span class="brand__name">Monday Night <b>Football</b></span>
        </a>
        <nav class="nav" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={n.match(path) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>

    <main id="main">
      <noscript>
        <div class="container page"><div class="card card--pad">This site shows live results and needs JavaScript switched on.</div></div>
      </noscript>
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="footer">
      <div class="container footer__in">
        <span>© Monday Night Football. An unofficial, friends-only football site — not affiliated with any league or club.</span>
        <span>Statistics are calculated from recorded match results; any totals from before records began are labelled.</span>
      </div>
    </footer>

    <nav class="tabbar" aria-label="Main">
      {nav.map((n) => (
        <a href={n.href} aria-current={n.match(path) ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[n.href]} /></svg>
          {n.label}
        </a>
      ))}
    </nav>
  </body>
</html>
